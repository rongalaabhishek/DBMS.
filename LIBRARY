/* =========================================================
   21. LIBRARY DASHBOARD SUMMARY
   ========================================================= */

SELECT
    (SELECT COUNT(*)
     FROM books) AS different_books,

    (SELECT COALESCE(SUM(total_copies), 0)
     FROM books) AS total_copies,

    (SELECT COALESCE(SUM(available_copies), 0)
     FROM books) AS available_copies,

    (SELECT COUNT(*)
     FROM transactions
     WHERE return_date IS NULL) AS currently_issued,

    (SELECT COUNT(*)
     FROM members) AS total_members,

    (SELECT COUNT(*)
     FROM authors) AS total_authors,

    (SELECT COUNT(*)
     FROM categories) AS total_categories,

    (SELECT COALESCE(SUM(fine), 0)
     FROM transactions) AS total_fine;


/* =========================================================
   22. CURRENTLY ISSUED BOOK DETAILS
   ========================================================= */

SELECT
    t.transaction_id,
    m.name AS member_name,
    b.title AS book_name,
    t.issue_date,
    t.due_date
FROM transactions t
JOIN members m
    ON t.member_id = m.member_id
JOIN books b
    ON t.book_id = b.book_id
WHERE t.return_date IS NULL;


/* =========================================================
   23. RETURNED BOOK DETAILS
   ========================================================= */

SELECT
    t.transaction_id,
    m.name AS member_name,
    b.title AS book_name,
    t.issue_date,
    t.due_date,
    t.return_date,
    t.fine
FROM transactions t
JOIN members m
    ON t.member_id = m.member_id
JOIN books b
    ON t.book_id = b.book_id
WHERE t.return_date IS NOT NULL;


/* =========================================================
   24. OVERDUE BOOKS
   ========================================================= */

SELECT
    t.transaction_id,
    m.name AS member_name,
    b.title AS book_name,
    t.due_date,
    DATEDIFF(CURDATE(), t.due_date) AS days_overdue,
    DATEDIFF(CURDATE(), t.due_date) * 5 AS current_fine
FROM transactions t
JOIN members m
    ON t.member_id = m.member_id
JOIN books b
    ON t.book_id = b.book_id
WHERE t.return_date IS NULL
AND t.due_date < CURDATE();


/* =========================================================
   25. SEARCH BOOK BY TITLE
   ========================================================= */

SELECT
    b.book_id,
    b.title,
    a.author_name,
    c.category_name,
    b.publisher,
    b.available_copies
FROM books b
JOIN authors a
    ON b.author_id = a.author_id
JOIN categories c
    ON b.category_id = c.category_id
WHERE b.title LIKE '%Database%';


/* =========================================================
   26. SEARCH BOOKS BY CATEGORY
   ========================================================= */

SELECT
    b.book_id,
    b.title,
    a.author_name,
    c.category_name,
    b.available_copies
FROM books b
JOIN authors a
    ON b.author_id = a.author_id
JOIN categories c
    ON b.category_id = c.category_id
WHERE c.category_name = 'Programming';


/* =========================================================
   27. SEARCH MEMBER BY NAME
   ========================================================= */

SELECT
    member_id,
    name,
    department,
    phone,
    email
FROM members
WHERE name LIKE '%Ravi%';


/* =========================================================
   28. MOST BORROWED BOOK
   ========================================================= */

SELECT
    b.book_id,
    b.title,
    COUNT(t.transaction_id) AS times_borrowed
FROM books b
LEFT JOIN transactions t
    ON b.book_id = t.book_id
GROUP BY b.book_id, b.title
ORDER BY times_borrowed DESC
LIMIT 1;


/* =========================================================
   29. MEMBER WITH MOST BORROWED BOOKS
   ========================================================= */

SELECT
    m.member_id,
    m.name,
    COUNT(t.transaction_id) AS books_borrowed
FROM members m
LEFT JOIN transactions t
    ON m.member_id = t.member_id
GROUP BY m.member_id, m.name
ORDER BY books_borrowed DESC
LIMIT 1;


/* =========================================================
   30. TOTAL MEMBERS BY DEPARTMENT
   ========================================================= */

SELECT
    department,
    COUNT(*) AS total_members
FROM members
GROUP BY department
ORDER BY total_members DESC;


/* =========================================================
   31. TOTAL BOOKS BY CATEGORY
   ========================================================= */

SELECT
    c.category_name,
    COALESCE(SUM(b.total_copies), 0) AS total_copies,
    COALESCE(SUM(b.available_copies), 0) AS available_copies
FROM categories c
LEFT JOIN books b
    ON c.category_id = b.category_id
GROUP BY c.category_id, c.category_name
ORDER BY total_copies DESC;


/* =========================================================
   32. LOW STOCK BOOKS
   ========================================================= */

SELECT
    book_id,
    title,
    total_copies,
    available_copies
FROM books
WHERE available_copies <= 1;


