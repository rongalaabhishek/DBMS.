/* =========================================================
   35. MEMBER BORROWING HISTORY
   ========================================================= */

SELECT
    m.name AS member_name,
    b.title AS book_name,
    t.issue_date,
    t.due_date,
    t.return_date,
    t.fine
FROM transactions t
JOIN members m
    ON t.member_id = m.member_id
JOIN books b
    ON t.book_id = b.book_id
WHERE m.member_id = 1
ORDER BY t.issue_date DESC;


/* =========================================================
   36. BOOK TRANSACTION HISTORY
   ========================================================= */

SELECT
    b.title AS book_name,
    m.name AS member_name,
    t.issue_date,
    t.due_date,
    t.return_date,
    t.fine
FROM transactions t
JOIN books b
    ON t.book_id = b.book_id
JOIN members m
    ON t.member_id = m.member_id
WHERE b.book_id = 1
ORDER BY t.issue_date DESC;


/* =========================================================
   37. AVAILABLE BOOKS
   ========================================================= */

SELECT
    b.book_id,
    b.title,
    a.author_name,
    c.category_name,
    b.available_copies
FROM books b
JOIN authors a
    ON b.author_id = a.author_id
JOIN categories c
    ON b.category_id = c.category_id
WHERE b.available_copies > 0;


/* =========================================================
   38. UNAVAILABLE BOOKS
   ========================================================= */

SELECT
    b.book_id,
    b.title,
    a.author_name,
    c.category_name
FROM books b
JOIN authors a
    ON b.author_id = a.author_id
JOIN categories c
    ON b.category_id = c.category_id
WHERE b.available_copies = 0;


/* =========================================================
   39. TOTAL FINE COLLECTED
   ========================================================= */

SELECT
    COALESCE(SUM(fine), 0) AS total_fine_collected
FROM transactions;


/* =========================================================
   40. COMPLETE TRANSACTION REPORT
   ========================================================= */

SELECT
    t.transaction_id,
    m.name AS member_name,
    m.department,
    b.title AS book_name,
    a.author_name,
    c.category_name,
    t.issue_date,
    t.due_date,
    t.return_date,
    t.fine
FROM transactions t
JOIN members m
    ON t.member_id = m.member_id
JOIN books b
    ON t.book_id = b.book_id
JOIN authors a
    ON b.author_id = a.author_id
JOIN categories c
    ON b.category_id = c.category_id
ORDER BY t.issue_date DESC;


